{
  "expo": {
    "name": "Geo-Locked Class",
    "slug": "geo-locked-class",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#667eea",
      "resizeMode": "contain"
    },
    "scheme": "geo-locked-class",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.visitha.geolockedclass",
      "icon": "./assets/icon.png",
      "splash": {
        "image": "./assets/icon.png",
        "backgroundColor": "#667eea",
        "resizeMode": "contain"
      }
    },
    "android": {
      "package": "com.visitha.geolockedclass",
      "versionCode": 1,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#667eea"
      },
      "splash": {
        "image": "./assets/icon.png",
        "backgroundColor": "#667eea",
        "resizeMode": "contain"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-location",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#667eea"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "1cf2f72a-aca6-403f-8092-7afdc4c47cd2"
      }
    }
  }
}
